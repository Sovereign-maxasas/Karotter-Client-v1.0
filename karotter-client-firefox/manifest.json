{
  "manifest_version": 3,
  "name": "Karotter Client",
  "version": "1.1.0",
  "description": "Karotterをもっと便利に。キーボードショートカット、投稿テンプレート、画像保存、統計表示など。",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://api.karotter.com/*",
    "https://karotter.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "96":  "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "karotter-client@itibarayuki.gmail.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://karotter.com/*"],
      "js": ["content/main.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "settings.html"
      ],
      "matches": ["https://karotter.com/*"]
    }
  ]
}
